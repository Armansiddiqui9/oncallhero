# Environment (secrets never committed)
# LLM
LLM_PROVIDER=chain                 # ollama | anthropic | scripted | chain
ANTHROPIC_API_KEY=
OLLAMA_API_BASE=http://127.0.0.1:11434

# Temporal
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=oncall

# Gateway
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000

# Demo timing
DEMO_MODE=true                     # short timers
